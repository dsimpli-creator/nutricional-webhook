<?xml version="1.0" encoding="utf-8"?>
<!--
  Nutricional Webhook: o app só fala com o Nutricional, sempre por HTTPS, e confia apenas
  nas autoridades certificadoras do sistema (certificados instalados pelo usuário não valem).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
